	a_expr:  a_expr.'+' a_expr 
	a_expr:  a_expr.'-' a_expr 
	a_expr:  a_expr.'*' a_expr 
	a_expr:  a_expr.'/' a_expr 
	a_expr:  a_expr.'%' a_expr 
	a_expr:  a_expr.'^' a_expr 
