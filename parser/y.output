	AlterOwnerStmt:  ALTER TEXT_P SEARCH CONFIGURATION.any_name OWNER TO RoleSpec 
	AlterTSConfigurationStmt:  ALTER TEXT_P SEARCH CONFIGURATION.any_name ADD_P MAPPING FOR name_list WITH any_name_list 
	AlterTSConfigurationStmt:  ALTER TEXT_P SEARCH CONFIGURATION.any_name ALTER MAPPING FOR name_list WITH any_name_list 
